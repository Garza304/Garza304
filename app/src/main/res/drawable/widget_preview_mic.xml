        <shape android:shape="oval"><solid android:color="#FFB9A7FF" /></shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_widget_mic_preview"
        android:gravity="center" />
</layer-list>
